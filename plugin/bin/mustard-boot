#!/usr/bin/env sh
# mustard-boot — first-run bootstrap for the Mustard plugin binaries.
#
# The plugin ships WITHOUT binaries (plugin/bin/* executables are build
# artifacts, never committed). The SessionStart hook goes through this script:
# when `mustard-rt` is missing — or was downloaded for a different plugin
# version — it fetches `mustard-bins-<version>-<os>` from the GitHub Release
# matching plugin.json's version, extracts it here, then delegates to the
# binary. Every failure path is silent-allow: a hook must NEVER wedge the
# session, so on any error this script exits 0 and the harness stays dormant
# for the session (next SessionStart retries).
#
# Dev machines are exempt from re-downloads: a locally built bin/ has no
# `.version` stamp, and a missing stamp is treated as "hands off".
#
# WHO PAYS FOR THE DOWNLOAD — and it is not "whoever gets here first". Every
# hook comes through this script, and the harness gives each one its own budget
# (`timeout` in plugin/hooks/hooks.json); the tightest is 15 seconds, and that
# is not only SessionEnd — the `clear|compact|resume|fork` arm of SessionStart
# carries 15 too. A download has no ceiling the caller can see, so a 15-second
# hook that opens one is not unlucky, it is cancelled: the harness kills it and
# prints `Hook cancelled` (field, Windows, 2026-08-28 — SessionEnd, right after
# the plugin changed version, so nothing after it ran and the session's OTEL
# collector outlived the project).
#
# So the fetch belongs to the callers that can afford it: `on SessionStart`,
# whose whole job is preparing the session, and any NON-hook caller — the
# installer warms the plugin up with `mustard-boot --version`, and wraps that in
# a `timeout` of its own. Every other trigger stays dormant for the session
# instead of being cut, which is the promise the paragraph above already makes.
# `--max-time` on the fetch is the second half of the same rule: even a caller
# that may pay cannot pay forever.
set -u

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 0
RT="$DIR/mustard-rt"
MANIFEST="$DIR/../.claude-plugin/plugin.json"
STAMP="$DIR/.version"

# THE FAST PATH, and it is why every hook can afford to come through here.
#
# A binary that is present and carries no stamp is a local build — "hands off",
# per the header — so there is nothing to decide and nothing to read. Handing
# over immediately keeps this shim at the cost of one `exec`; the version
# lookup below spawns `sed` on every single invocation, which is 10x this
# script's whole runtime (measured: 12 hundredths of a second versus 1).
#
# That difference is what decides whether this file can sit in front of
# PreToolUse, which fires on every tool call, or only in front of SessionStart,
# which fires once. It used to be only SessionStart — and so a plugin whose
# `bin/` had not been populated yet failed on ten OTHER hooks before the one
# that knows how to fix it ever ran.
if [ -x "$RT" ] && [ ! -f "$STAMP" ]; then
  exec "$RT" "$@"
fi

VER=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$MANIFEST" 2>/dev/null | head -n 1)

# A stamped binary matching the manifest is also settled: hand over without
# touching the network.
if [ -x "$RT" ] && [ -n "$VER" ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$VER" ]; then
  exec "$RT" "$@"
fi

need_fetch=0
if [ ! -x "$RT" ]; then
  need_fetch=1
elif [ -f "$STAMP" ] && [ -n "$VER" ] && [ "$(cat "$STAMP" 2>/dev/null)" != "$VER" ]; then
  need_fetch=1
fi

# The gate is the trigger the harness passed on argv (`on <Trigger>`), not an
# environment variable: `VAR=1 prog` is POSIX syntax the Windows twin's `cmd`
# cannot parse, and the two bodies have to answer the same way. Anything that
# does not open with `on` is not a hook at all — the installer's `--version`
# warm-up — and keeps the right to fetch.
#
# Dropping `need_fetch` here rather than skipping the block below is what makes
# the short-budget path silent AND cheap: no `uname`, no notice, and a binary
# that is merely stamped for another version still gets `exec`'d at the tail —
# an old harness beats a dormant one.
if [ "${1-}" = "on" ] && [ "${2-}" != "SessionStart" ]; then
  need_fetch=0
fi

# A manifest this script cannot read a version out of is the one failure that is
# BOTH silent and total. `need_fetch` says the binaries have to come down, `$VER`
# names no release to fetch them from, and every branch below is guarded on
# `-n "$VER"` — so nothing happens, nothing is printed, and on a machine whose
# `bin/` was never populated the harness is dormant forever with no line on
# screen saying why. There is still nothing to download (there is no URL to
# build), but the operator is told, and told WHICH file to look at. Only a caller
# that was actually going to fetch says anything, so the short-budget path above
# stays as quiet as its own paragraph promises.
if [ "$need_fetch" = "1" ] && [ -z "$VER" ]; then
  echo "[mustard-boot] no \"version\" readable in $MANIFEST — mustard hooks stay dormant this session" >&2
fi

# Declared before the branch: `set -u` at the top of this file makes an unset
# variable fatal, and the second test below reads `$os` whether or not the
# branch that assigns it ran.
os=""
if [ "$need_fetch" = "1" ] && [ -n "$VER" ]; then
  # Named, not assumed. The catch-all used to be `linux-x64`, so any system
  # that is not macOS asked for the Linux bundle — a guess this project spent a
  # whole cycle removing from its own code. Windows never reaches this line
  # (`mustard-boot.cmd` is its twin, and `cmd` resolves it by PATHEXT), but a
  # wrong download is a silent failure and an unnamed system deserves the
  # honest answer: do nothing, and say why.
  case "$(uname -s)" in
    Darwin)                        os="macos-universal" ;;
    Linux)                         os="linux-x64" ;;
    MINGW*|MSYS*|CYGWIN*|Windows*) os="windows-x64" ;;
    *) echo "[mustard-boot] no published bundle for $(uname -s) — hooks stay dormant" >&2
       os="" ;;
  esac
fi

# An unnamed system named no bundle above, so there is nothing to fetch and the
# `exec` below simply does not happen — dormant, which is this script's one
# promise on every failure path.
if [ "$need_fetch" = "1" ] && [ -n "$VER" ] && [ -n "$os" ]; then
  url="https://github.com/rubensrpj/mustard/releases/download/v${VER}/mustard-bins-${VER}-${os}.tar.gz"
  tmp="$DIR/.boot-tmp"
  mkdir -p "$tmp"
  echo "[mustard-boot] fetching plugin binaries v${VER} (first run)" >&2
  # Downloading and unpacking fail for different reasons, so they say different
  # things. The single shared "download failed" message sent a diagnosis session
  # hunting a network that was perfectly fine — on the Windows twin, where the
  # download had succeeded and only the extraction had not (field, 2026-08-27).
  #
  # `--max-time 10` is the ceiling, and the number is not free: the tightest
  # budget that can still reach this line is 15 seconds (the
  # `clear|compact|resume|fork` arm of SessionStart), and the unpack plus the
  # `exec` still have to fit after it. A connection that HANGS rather than
  # refuses — captive portal, a proxy that swallows the packet — is the case
  # this covers; it now costs ten seconds and a dormant session instead of a
  # cancelled hook. Keep this literal and keep it in step with the `.cmd` twin.
  if ! curl -fsSL --max-time 10 "$url" -o "$tmp/bins.tar.gz"; then
    echo "[mustard-boot] download failed ($url) — mustard hooks stay dormant this session" >&2
  elif ! tar -xzf "$tmp/bins.tar.gz" -C "$DIR"; then
    echo "[mustard-boot] downloaded, but could not unpack into $DIR — mustard hooks stay dormant this session" >&2
  else
    printf '%s' "$VER" > "$STAMP"
    chmod +x "$DIR/mustard-rt" "$DIR/scan" "$DIR/mustard-mcp" "$DIR/mustard" 2>/dev/null || true
  fi
  rm -rf "$tmp" 2>/dev/null || true
fi

if [ -x "$RT" ]; then
  exec "$RT" "$@"
fi
exit 0

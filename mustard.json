{
  "git": {
    "flow": {
      "*": "dev",
      "dev": "main"
    },
    "provider": "github"
  },
  "buildCommand": "cargo build --workspace",
  "testCommand": "cargo test",
  "lintCommand": "cargo clippy",
  "typeCheckCommand": "cargo check",
  "specLang": "pt-BR",
  "tone": "didactic",
  "inject": [
    {
      "on": "userPromptSubmit",
      "file": ".claude/mustard/orchestrator.md",
      "once": true
    },
    {
      "on": "sessionStart",
      "file": ".claude/mustard/dispatch.md",
      "once": true
    }
  ],
  "runtime": {
    "kind": "native",
    "os": "linux",
    "arch": "x86_64"
  },
  "version": "0.1.37"
}

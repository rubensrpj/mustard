# Batch/cmd scripts break under cmd.exe with LF-only line endings (the parser
# mis-reads labels and eats characters) — force CRLF on every checkout.
*.cmd text eol=crlf
*.bat text eol=crlf

# POSIX shell scripts must stay LF everywhere (CRLF breaks the shebang).
plugin/bin/mustard-boot text eol=lf
*.sh text eol=lf

# Os moldes que o instalador escreve e o binário mede são lidos byte a byte
# (teto de tamanho, e o texto tem de abrir com o próprio nome): o fim de linha
# do Windows mudaria os dois. Ficam sempre em LF.
packages/core/templates/** text eol=lf

# Os retratos comparados byte a byte com o que o binário gera: o fim de linha
# do Windows mudaria o arquivo lido, nunca o gerado.
apps/rt/tests/fixtures/** text eol=lf

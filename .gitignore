# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Rust build artifacts. One workspace, one target dir — the dashboard backend
# is a normal member crate, so it has no target/ of its own. The CLI payload the
# Windows installer stages is built under `dist/_win-payload`, already covered
# by the `dist/` rule above.
target/

# OS files
.DS_Store
Thumbs.db
nul

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sw?

# Environment
.env
.env.*
*.local

# Per-build version counter (install.ps1 increments this and feeds it to the
# cargo build as MUSTARD_BUILD_NUMBER; local-only, regenerable from 1)
.mustard-build-number

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Coverage
coverage/

# pnpm
.pnpm-store/

# TypeScript build cache
*.tsbuildinfo

# Agent memory (session-scoped, auto-cleaned)
.claude/.agent-memory/

# Mustard runtime caches (W2 cache reorg: detect.json, scan-dispatch.json,
# knowledge-seen.json, memory-seen.json all consolidated under .cache/)
.claude/.cache/

# Enforcement metrics (append-only, local telemetry)
.claude/.metrics/

# Agent runtime state (session-scoped)
.claude/.agent-state/

# Harness runtime state
.claude/.harness/

# Compaction memory (session-scoped, ephemeral)
.claude/.compact-state/

# Nested .claude runtime state (subprojects / imported trees)
**/.claude/.harness/
**/.claude/.metrics/
**/.claude/.compact-state/
**/.claude/.cache/

# Timestamped backups created by mustard init/update
.claude.backup.*/

# Dashboard runtime
.claude/.dashboard.pid
.claude/.dashboard.port
dashboard-html.txt

# Playwright MCP snapshots
.playwright-mcp/

# CLI template fixtures (regenerable runtime state)
packages/cli/templates/.claude/.harness/
packages/cli/templates/.claude/.metrics/

# Per-spec event log + blob spill (NDJSON, regenerable)
**/.claude/spec/*/.events/
**/.claude/spec/*/.blobs/

# Rendered dispatch prompts (`agent-prompt-render --emit ref`, regenerable)
**/.claude/.dispatch/
**/.claude/spec/*/.dispatch/

# Full feature digest (`run feature` writes it; stdout is only a compact summary). Regenerable per query.
**/.claude/feature-digest.json

# Plan-mode plan files (harness carve-out, regenerable, never code).
**/.claude/plans/

# The two GATE MARKERS. Ignored not because they are regenerable — they are
# not — but because versioning them would defeat the gate they stand for:
# `approve-spec` decides on the PRESENCE of `.approved-by-user`, so a committed
# marker would let `git clone` hand a fresh checkout an approval nobody gave.
# `.clarified` is the same shape for the clarify gate.
**/.claude/spec/*/.approved-by-user
**/.claude/spec/*/.clarified

# The VERBATIM operator prompts, recorded word for word as they were typed.
# Written for the operator to re-read, never to be published — and nobody
# re-reads them before a commit does.
**/.claude/spec/*/change-log.md
**/.claude/spec/*/change-requests.ndjson

# Per-clone local guidance. It was covered only by the harness's clone-local
# exclude, which does not travel — so every clone had to re-create the rule, and
# a clone that did not saw the file as untracked work.
CLAUDE.local.md

# Relevance-gate output: approved spec-memory names (regenerable per spec)
**/.claude/spec/*/.memory-approved

# The cut's own record of the base a unit came from (harness state; the draft
# folds it into meta.json#base and retires it — it never reaches the merge)
**/.claude/spec/*/.cut-base

# Python bytecode (skill-creator scripts)
**/__pycache__/

# Per-machine Claude Code settings (installer-written overrides, e.g. statusLine binary path)
**/.claude/settings.local.json

# Runtime knowledge store + local session/editor data (per-project, regenerable — not code)
**/.claude/knowledge/
**/.claude/memory/
**/.claude/agent-memory/
**/.claude/.session/
**/.claude/.obsidian/

# Per-spec QA reports (W2 path catalog: moved out of .claude/.qa-reports/)
**/.claude/spec/*/qa-report.json
**/.claude/spec/*/qa-report.html

# Per-spec economy baselines (W2 path catalog: moved out of
# .claude/.economy-baselines.json)
**/.claude/spec/*/economy-baselines.json

# Per-wave artefacts (W2 path catalog: moved out of .claude/.pipeline-states/)
**/.claude/spec/*/wave-*/diff.md
**/.claude/spec/*/wave-*/prompt.md
**/.claude/spec/*/wave-*/warnings.txt

# Ad-hoc test-run captures dropped in the repo root (scratch, regenerable)
/full_test_out.txt

# Plugin binaries são artefato de build (release workflow popula plugin/bin/,
# ou o mustard-boot baixa dos assets do Release); nunca commitar. Os scripts
# mustard-boot / mustard-boot.cmd SÃO commitados — não casar com eles aqui.
plugin/bin/*.exe
plugin/bin/*.old
plugin/bin/*.old-*
plugin/bin/mustard-rt
plugin/bin/scan
plugin/bin/mustard-mcp
plugin/bin/mustard
plugin/bin/*-macos
plugin/bin/.version
plugin/bin/.boot-tmp/

# Saída de build .NET dentro das fixtures do scan. Foi commitada por engano de
# uma máquina Windows: os arquivos embutem o SHA do commit corrente e um
# caminho absoluto (`C:\Atiz\...`), então nunca ficam limpos entre commits nem
# entre máquinas. Nada as lê — `PRUNE_DIRS` (packages/core/src/io/fs/mod.rs)
# já faz o scanner pular `obj`/`bin`.
apps/scan/tests/fixtures/**/obj/
apps/scan/tests/fixtures/**/bin/
